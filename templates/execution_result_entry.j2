---
Timestamp             : {{ _execution_result_entry.timestamp }}
Host OS               : {{ _execution_result_entry.host_os }}
Project               : {{ _execution_result_entry.project }}
Organization          : {{ _execution_result_entry.organization }}
Job Template          : {{ _execution_result_entry.job_template }}
Playbook              : {{ _execution_result_entry.playbook }}
SCM Branch            : {{ _execution_result_entry.scm_branch }}
SCM Revision          : {{ _execution_result_entry.scm_revision }}
Execution Environment : {{ _execution_result_entry.execution_environment }}
Status                : {{ _execution_result_entry.status }}
Return Code           : {{ _execution_result_entry.return_code }}
Failed Task           : {{ _execution_result_entry.failed_task }}
Failed Task Module    : {{ _execution_result_entry.failed_task_module }}
Message     :
  {{ _execution_result_entry.message | indent(2) }}
Stdout      :
  {{ _execution_result_entry.stdout | indent(2) }}
Stderr      :
  {{ _execution_result_entry.stderr | indent(2) }}
Exception   :
  {{ _execution_result_entry.exception | indent(2) }}
{% if _execution_result_entry.warnings | length > 0 %}
Warnings    :
{% for warning in _execution_result_entry.warnings %}
  [{{ loop.index }}] {{ warning }}
{% endfor %}
{% endif %}
---
